# ========================================================
# CodeDuel AI Copilot — Bepul API Kalitlari Sozlamalari
# ========================================================

# 1. ⚡ Groq Cloud (ENG TAVSIYA ETILADI / 100% BEPUL / 500+ tok/s)
# Olish uchun: https://console.groq.com/keys -> Create API Key
# Bepul limit: 14,400 so'rov/kun, karta talab qilinmaydi!
VITE_GROQ_API_KEY=gsk_...

# 2. 💻 Mistral AI / Codestral (Dasturlash uchun maxsus AI)
# Olish uchun: https://console.mistral.ai/api-keys
VITE_MISTRAL_API_KEY=your_mistral_api_key_here

# 3. 🤗 Hugging Face (Qwen 2.5 Coder 32B Serverless)
# Olish uchun: https://huggingface.co/settings/tokens
VITE_HF_API_KEY=hf_...

# 4. 🌐 OpenRouter Free Models (DeepSeek R1, Llama 3.3)
# Olish uchun: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=sk-or-...

# 5. ✨ Google Gemini API (Free Tier)
# Olish uchun: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=AIzaSy...
