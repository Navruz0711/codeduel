    "title": "Two Sum",
    "slug": "two-sum",
    "description": "Berilgan sonlar massividan shunday ikkita sonning indeksini topingki, ularning yig'indisi `target` ga teng bo'lsin.",
    "examples": [
      { "input": "[2, 7, 11, 15], 9", "output": "[0, 1]" }
    ],
    "difficulty": 4,
    "category": "Algorithms",
    "tags": ["arrays", "hash-table"],
    "isPremium": true,
    "languages": {
      "javascript": {
        "initialCode": "function twoSum(nums, target) {\n  const map = new Map();\n  for (let i = 0; i < nums.length; i++) {\n    const diff = target - nums[i];\n    if (map.has(diff)) return [map.get(diff), i];\n    map.set(nums[i], i);\n  }\n}",
        "tests": [
          { "input": "console.log(JSON.stringify(twoSum([2, 7, 11, 15], 9)))", "expected": "[0,1]", "label": "Target 9" },
          { "input": "console.log(JSON.stringify(twoSum([3, 2, 4], 6)))", "expected": "[1,2]", "label": "Target 6" }
        ]
      }
    },
    "xpReward": 100
  }
